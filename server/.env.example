# Copy to .env on the server. Replace every placeholder; never commit the real file.
SHELEST_SECRET_KEY=replace-with-a-long-random-secret
SHELEST_DEBUG=false
SHELEST_ALLOWED_HOSTS=api.shelest-book.ru,shelest-book.ru
SHELEST_FORCE_HTTPS=true
SHELEST_GOOGLE_CLIENT_IDS=android-client-id.apps.googleusercontent.com
SHELEST_MAX_BOOK_BYTES=104857600
SHELEST_MAX_STORAGE_BYTES=5368709120
# Optional paths; defaults are server/var/shelest.sqlite3 and server/var/books.
# SHELEST_DATA_DIR=/var/lib/shelest
# SHELEST_BOOKS_DIR=/var/lib/shelest/books
