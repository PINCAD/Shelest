<?xml version="1.0" encoding="utf-8"?>
<!--
  Two cells by two: a bookmark on the home screen.

  Everything the tile has left over goes to the cover — it is given weight rather than a height,
  so it grows with whatever the launcher's cell turns out to be instead of being sized for one
  guessed-at grid. Under it, a title kept to a single line and the bar with the figure on it.
  The whole tile opens the book; there is no room for a second button and no honest way to
  shrink one.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- fitCenter, not centerCrop: a cover is a designed rectangle and cropping it cuts
             the title off its own artwork. Letting it sit inside the box keeps whatever
             proportions the publisher chose. -->
        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_cover_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_cover_placeholder" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/widget_progress" />

            <TextView
                android:id="@+id/widget_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/widget_empty_short"
        android:textColor="@color/widget_text_dim"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
